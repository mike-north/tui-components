{
  "name": "@tuicomponents/tree",
  "version": "0.1.0",
  "description": "Tree component for displaying hierarchical data",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": ["tui", "terminal", "tree", "hierarchy"],
  "license": "UNLICENSED",
  "dependencies": {
    "@tuicomponents/core": "workspace:*",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  },
  "peerDependencies": {
    "@tuicomponents/core": "workspace:*"
  }
}
