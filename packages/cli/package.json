{
  "name": "@tuicomponents/cli",
  "version": "0.3.1",
  "description": "CLI for TUI components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tui": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "api-report": "api-extractor run",
    "api-report:update": "api-extractor run --local",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "tui",
    "terminal",
    "cli"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@tuicomponents/box": "workspace:*",
    "@tuicomponents/callout": "workspace:*",
    "@tuicomponents/chart": "workspace:*",
    "@tuicomponents/core": "workspace:*",
    "@tuicomponents/diff": "workspace:*",
    "@tuicomponents/gauge": "workspace:*",
    "@tuicomponents/graph": "workspace:*",
    "@tuicomponents/keyvalue": "workspace:*",
    "@tuicomponents/layout": "workspace:*",
    "@tuicomponents/list": "workspace:*",
    "@tuicomponents/progress": "workspace:*",
    "@tuicomponents/sparkline": "workspace:*",
    "@tuicomponents/table": "workspace:*",
    "@tuicomponents/tree": "workspace:*",
    "commander": "^14.0.0",
    "is-agentic-tui": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
