{
  "name": "@tuicomponents/core",
  "version": "0.1.0",
  "description": "Core utilities for TUI components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsd",
    "api-report": "api-extractor run",
    "api-report:update": "api-extractor run --local",
    "clean": "rm -rf dist temp"
  },
  "keywords": [
    "tui",
    "terminal",
    "cli",
    "core"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "chromaterm": "^0.1.0",
    "string-width": "^7.2.0",
    "terminal-size": "^4.0.0",
    "wrap-ansi": "^9.0.0",
    "zod": "^3.25.17",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsd": "^0.32.0"
  },
  "tsd": {
    "directory": "test"
  }
}
