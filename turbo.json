{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:types": {
      "dependsOn": ["build"]
    },
    "api-report": {
      "dependsOn": ["build"],
      "inputs": ["dist/**/*.d.ts", "api-extractor.json"],
      "outputs": []
    },
    "api-report:update": {
      "dependsOn": ["build"],
      "inputs": ["dist/**/*.d.ts", "api-extractor.json"],
      "outputs": ["api-report/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
