{
  "name": "tui-components-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal UI components for CLI and AI assistants",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:types": "turbo run test:types",
    "api-report": "turbo run api-report",
    "api-report:update": "turbo run api-report:update",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs:screenshots": "tsx scripts/docs/generate-screenshots.ts",
    "docs:screenshots:validate": "tsx scripts/docs/generate-screenshots.ts --validate",
    "docs:screenshots:docker": "tsx scripts/docs/generate-screenshots.ts --docker",
    "docs:readme": "node --import=tsx/esm scripts/docs/generate-readmes.ts",
    "docs:snapshots": "FORCE_COLOR=3 tsx scripts/docs/generate-snapshots.ts",
    "docs:snapshots:update": "FORCE_COLOR=3 tsx scripts/docs/generate-snapshots.ts --update"
  },
  "keywords": [
    "tui",
    "terminal",
    "cli",
    "components"
  ],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.27.0",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/sharp": "^0.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "ansi-to-svg": "^1.4.3",
    "canvas": "^3.2.1",
    "chalk": "^5.6.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "sharp": "^0.34.5",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
