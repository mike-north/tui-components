{
  "name": "tui-components-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal UI components for CLI and AI assistants",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:types": "turbo run test:types",
    "api-report": "turbo run api-report",
    "api-report:update": "turbo run api-report:update",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": ["tui", "terminal", "cli", "components"],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.27.0",
    "@microsoft/api-extractor": "^7.52.8",
    "typescript-eslint": "^8.32.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "turbo": "^2.5.3",
    "typescript": "^5.9.3",
    "vitest": "^3.1.3"
  }
}
