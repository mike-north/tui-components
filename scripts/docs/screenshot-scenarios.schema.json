{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tuicomponents.dev/schemas/screenshot-scenarios.json",
  "title": "TUI Components Screenshot Scenarios",
  "description": "Schema for defining screenshot scenarios for TUI component documentation",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "description": "Array of scenarios for a component",
    "items": {
      "$ref": "#/$defs/scenario"
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "description": "A single screenshot scenario",
      "required": ["name", "description", "input"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique scenario name (used as filename without extension)",
          "pattern": "^[a-z0-9-]+$"
        },
        "description": {
          "type": "string",
          "description": "Brief description for documentation"
        },
        "width": {
          "type": "integer",
          "description": "Render width in characters",
          "default": 80,
          "minimum": 20,
          "maximum": 200
        },
        "input": {
          "description": "Component input data (validated against component's Zod schema at runtime)"
        }
      },
      "additionalProperties": false
    },
    "sparklineInput": {
      "type": "object",
      "description": "Sparkline component input",
      "required": ["data"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Array of numeric values to visualize"
        },
        "min": {
          "type": "number",
          "description": "Minimum value for scaling"
        },
        "max": {
          "type": "number",
          "description": "Maximum value for scaling"
        },
        "showMinMax": {
          "type": "boolean",
          "description": "Show min/max labels"
        }
      }
    },
    "chartInput": {
      "type": "object",
      "description": "Chart component input",
      "required": ["type", "series"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bar",
            "bar-vertical",
            "bar-stacked",
            "bar-stacked-vertical",
            "line",
            "area",
            "area-stacked",
            "scatter",
            "pie",
            "donut",
            "heatmap"
          ],
          "description": "Chart type"
        },
        "series": {
          "type": "array",
          "description": "Data series"
        },
        "title": {
          "type": "string",
          "description": "Chart title"
        },
        "height": {
          "type": "integer",
          "description": "Chart height in lines"
        },
        "showValues": {
          "type": "boolean",
          "description": "Show values on data points"
        },
        "showAxes": {
          "type": "boolean",
          "description": "Show axes"
        },
        "lineStyle": {
          "type": "string",
          "enum": ["blocks", "braille", "dots"],
          "description": "Line rendering style"
        },
        "barStyle": {
          "type": "string",
          "enum": ["block", "shaded", "light", "hash", "equals", "arrow"],
          "description": "Bar fill style"
        },
        "scatterStyle": {
          "type": "string",
          "enum": ["dots", "braille"],
          "description": "Scatter rendering style"
        },
        "heatmapStyle": {
          "type": "string",
          "enum": ["blocks", "ascii", "numeric"],
          "description": "Heatmap rendering style"
        },
        "centerLabel": {
          "type": "string",
          "description": "Center label for donut charts"
        },
        "innerRadius": {
          "type": "number",
          "description": "Inner radius for donut charts (0-0.9)"
        },
        "xAxis": {
          "type": "object",
          "description": "X-axis configuration"
        },
        "yAxis": {
          "type": "object",
          "description": "Y-axis configuration"
        },
        "legend": {
          "type": "object",
          "description": "Legend configuration"
        }
      }
    },
    "tableInput": {
      "type": "object",
      "description": "Table component input",
      "required": ["columns", "data"],
      "properties": {
        "columns": {
          "type": "array",
          "description": "Column definitions"
        },
        "data": {
          "type": "array",
          "description": "Table row data"
        },
        "style": {
          "type": "string",
          "description": "Table style"
        }
      }
    },
    "boxInput": {
      "type": "object",
      "description": "Box component input",
      "required": ["content"],
      "properties": {
        "content": {
          "type": "string",
          "description": "Box content"
        },
        "title": {
          "type": "string",
          "description": "Box title"
        },
        "style": {
          "type": "string",
          "description": "Box border style"
        },
        "padding": {
          "type": "integer",
          "description": "Inner padding"
        }
      }
    },
    "listInput": {
      "type": "object",
      "description": "List component input",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "description": "List items"
        },
        "style": {
          "type": "string",
          "enum": ["bullet", "numbered", "checkbox"],
          "description": "List style"
        }
      }
    },
    "treeInput": {
      "type": "object",
      "description": "Tree component input",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "description": "Node label"
        },
        "children": {
          "type": "array",
          "description": "Child nodes"
        }
      }
    },
    "progressInput": {
      "type": "object",
      "description": "Progress component input",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "number",
          "description": "Current value"
        },
        "max": {
          "type": "number",
          "description": "Maximum value"
        },
        "width": {
          "type": "integer",
          "description": "Bar width"
        },
        "label": {
          "type": "string",
          "description": "Progress label"
        },
        "showPercentage": {
          "type": "boolean",
          "description": "Show percentage"
        }
      }
    },
    "gaugeInput": {
      "type": "object",
      "description": "Gauge component input",
      "required": ["value"],
      "properties": {
        "value": {
          "type": "number",
          "description": "Current value"
        },
        "max": {
          "type": "number",
          "description": "Maximum value"
        },
        "label": {
          "type": "string",
          "description": "Gauge label"
        },
        "showValue": {
          "type": "boolean",
          "description": "Show value"
        }
      }
    },
    "diffInput": {
      "type": "object",
      "description": "Diff component input",
      "required": ["oldText", "newText"],
      "properties": {
        "oldText": {
          "type": "string",
          "description": "Original text"
        },
        "newText": {
          "type": "string",
          "description": "Modified text"
        }
      }
    },
    "keyvalueInput": {
      "type": "object",
      "description": "Key-value component input",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "description": "Key-value pairs"
        }
      }
    },
    "graphInput": {
      "type": "object",
      "description": "Graph component input",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "description": "Graph nodes"
        },
        "edges": {
          "type": "array",
          "description": "Graph edges"
        }
      }
    }
  }
}
